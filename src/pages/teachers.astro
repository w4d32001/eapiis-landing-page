---
import Layout from "@/layouts/Layout.astro";
import fondo from "../assets/img/paqchas.webp";
---

<Layout>
    <div class="relative w-full min-h-screen">
        <div
            class="absolute -top-20 inset-0 h-[calc(100vh-100px)] bg-black opacity-60 z-5"
        >
        </div>
        <div class="absolute -top-20 left-0 w-full h-[calc(100vh-100px)]">
            <img
                src={fondo.src}
                alt="Fondo de la página de docentes"
                class="w-full h-full object-cover"
            />
        </div>
        <div
            class="relative z-30 top-98 bg-secondary text-tertiary h-40 w-100 left-8 rounded-lg flex items-center justify-center text-2xl font-bold shadow-lg uppercase"
        >
            <h2 class="text-2xl font-bold text-start w-80">
                AUTORIDADES Y EQUIPO DOCENTE
            </h2>
        </div>
        <div class="w-full pt-96"></div>
        <h2
            class="text-2xl text-white text-center mb-8 after:content-[''] after:block after:w-20 after:h-1 after:bg-primary after:mx-auto after:mt-4"
        >
            Nuestras Autoridades
        </h2>
        <hr class="w-full h-0.5 text-accent" />
    </div>
</Layout>
