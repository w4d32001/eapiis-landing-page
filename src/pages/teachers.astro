---
import Layout from "@/layouts/Layout.astro";
import fondo from "@/assets/img/paqchas.webp";
import Separator from "@/components/ui/Separator.astro";
import fakeTeachers from "@/const/fake";
import TeacherDetails from "@/components/teacher/TeacherDetails.astro";
---

<Layout>
  <div class="w-full min-h-screen">
    <div class="relative h-[calc(80vh)] w-full overflow-hidden z-0">
      <img
        src={fondo.src}
        alt="Fondo de la página de docentes"
        class="absolute inset-0 w-full h-full object-cover z-0 -top-0"
      />
      <div class="absolute inset-0 bg-black/60 z-0"></div>
    </div>

    <div class="relative z-30 bg-white -mt-10 rounded-t-3xl pt-16 px-4 md:px-8">
      <div class="absolute z- mx-4 -top-15 text-white text-center">
        <div
          class="bg-secondary text-tertiary p-6 rounded-lg max-w-2xl shadow-lg"
        >
          <h2
            class="text-lg md:text-xl lg:text-2xl font-bold uppercase tracking-wider"
          >
            Nuestras autoridades y <br /> equipo docente
          </h2>
        </div>
      </div>
      <h2
        class="text-2xl md:text-3xl text-center mb-6 font-semibold tracking-wider"
      >
        Nuestras Autoridades
      </h2>
      <Separator />

      <div class="w-full grid grid-cols-1 md:grid-cols-2 gap-6 py-8 mx-auto">
        {fakeTeachers.map((teacher) => <TeacherDetails teacher={teacher} />)}
      </div>
    </div>
    <div class="my-8">
      <h2
        class="text-2xl text-white md:text-3xl text-center mb-6 font-semibold tracking-wider"
      >
        Nuestras Autoridades
      </h2>
      <div>
        <ul class="flex gap-x-4 items-center justify-around text-primary font-bold">
          <li><a href="" class="py-2 px-4 bg-white rounded">Ver todos</a></li>
          <li><a href="" class="py-2 px-4 bg-white rounded">Docente nombrados</a></li>
          <li><a href="" class="py-2 px-4 bg-white rounded">Docentes contratados</a></li>
          <li><a href="" class="py-2 px-4 bg-white rounded">Jefes de practica</a></li>
        </ul>
      </div>
    </div>
  </div>
</Layout>

<style>
  html,
  body {
    height: 100%;
  }
</style>
