---
import logo from "@/assets/img/logo.jpg";
---

<div class="flex items-center h-22 p-2 gap-x-2">
    <img src={logo.src} alt="Logo Universidad" class="w-16" />
    <div class="h-full flex items-center gap-x-0.5">
        <hr class="h-full w-0.5 bg-white" />
    </div>
    <span
        class="flex flex-col text-gray-300 font-bold font-roboto uppercase leading-tight"
    >
        <span class="text-[16px] font-light">Universidad Nacional</span>
        <span class="text-[16px]">Micaela Bastidas</span>
        <span class="text-[16px]">De Apurímac</span>
    </span>
</div>
